APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use a real SMTP/provider transport before accepting orders; log is development-only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@accountingchoice.com"
ADMIN_PASSWORD="password"

# Google Sign-In OAuth client. Register GOOGLE_REDIRECT_URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Midtrans Snap (use Sandbox keys until the integration is verified).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Local checkout without a gateway creates unpaid test orders only.
# CHECKOUT_OFFLINE_MODE=true

# Google Drive OAuth credentials for copying Sheets masters after verified payment.
# Enable the Drive API and authorize with the https://www.googleapis.com/auth/drive scope.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional destination folder for buyer copies.
GOOGLE_DRIVE_FOLDER_ID=

# Gemini API (Terpusat di config/gemini.php untuk semua fitur AI:
# Generate Produk, FAQ Chat, Rekomendasi Katalog, Panduan Produk, & Analisis Penjualan)
GEMINI_API_KEY=
# Opsional: Jika ingin failover otomatis ketika limit kuota (HTTP 429), pisahkan beberapa API key dengan koma:
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-flash-lite-latest
